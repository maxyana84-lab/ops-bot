# Copy to .env and fill in. Never commit .env.

# Token from @BotFather
TELEGRAM_TOKEN=

# Shared secret for webhooks (Authorization: Bearer <secret>), min 16 chars.
# Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=

# Where alerts go. Send /start to the bot to learn your chat id.
# Comma-separated; group chat ids are negative.
ALERT_CHAT_IDS=

# Who may run commands. Defaults to ALERT_CHAT_IDS if empty.
ALLOWED_CHAT_IDS=

CHECK_INTERVAL_SECONDS=60
FAILURE_THRESHOLD=2
